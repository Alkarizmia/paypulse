# Copier vers .env.local puis remplir avec Supabase → Project Settings → API
# Après toute modification : arrêter puis relancer `npm run dev`

NEXT_PUBLIC_SUPABASE_URL=https://ctfkwmorwhqdndzucfam.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bmPxqfjS-3RsMBoOXOGaoA_7gKOXbQf
# Requis pour le runner d'automatisation (/api/reminders/run) et pour synchroniser
# nom/téléphone → Authentication → Users (POST /api/sync-auth-profile).
# SUPABASE_SERVICE_ROLE_KEY=

# Optionnel — « Générer par IA » sur les modèles de relance (sans clé : texte de secours côté serveur)
# OPENAI_API_KEY=
# OPENAI_REMINDER_MODEL=gpt-4o-mini

# Routes /api/send-reminder et /api/reminder-draft-ai : session Supabase obligatoire
# (Authorization: Bearer <access_token>; le front dashboard envoie le token automatiquement pour l’IA).
# Limites anti-abus (optionnel, défaut dans le code)
# API_SEND_REMINDER_MAX_PER_USER_PER_HOUR=30
# API_REMINDER_AI_MAX_PER_USER_PER_10MIN=24

# Envoi e-mail via Resend (routes /api/send-reminder + runner auto /api/reminders/run)
# Sans domaine vérifié sur resend.com/domains, Resend n’autorise l’envoi qu’à l’e-mail du compte Resend.
# MAIL_FROM : relances envoyées depuis le dashboard (bouton / API).
# MAIL_FROM_AUTO_REMINDERS : relances automatiques uniquement ; si vide, même adresse que MAIL_FROM.
# Les deux doivent être des expéditeurs autorisés sur le domaine (ex. paypulss.com).
# RESEND_API_KEY=
# MAIL_FROM=contact@paypulss.com
# MAIL_FROM_AUTO_REMINDERS=relances@paypulss.com

# Dédoublonnage relances auto : par défaut, un seul e-mail par (portefeuille + e-mail + J+n + jour d’envoi).
# Si true : un seul e-mail par (e-mail + J+n + jour) sur tout le projet (plusieurs portefeuilles) — à n’activer que si le métier l’exige.
# REMINDER_GLOBAL_EMAIL_DEDUP=false true

# Exécution scheduler sécurisé
# CRON_SECRET=

# --- Stripe (abonnements) : produits / prix dans le Dashboard Stripe → IDs `price_…`
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# URL publique de l’app (success/cancel Checkout) — en prod : https://votredomaine.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_AGENCY_ANNUAL=
# Portail client (annulation / CB) : Stripe Dashboard → Paramètres → Portail client (activer les fonctions voulues).
